# Database Configuration
# Required: PostgreSQL connection string
# Format: postgres://[user]:[password]@[host]:[port]/[database]?[options]
#
# Local dev (postgres running on your host): use localhost:5432
# Docker Compose: DATABASE_URL is set automatically by docker-compose.yml
#                 using the internal service hostname `trmnl_db`. The DB port
#                 is NOT published to the host (to avoid colliding with other
#                 local postgres instances), so localhost:5432 won't reach it.
DATABASE_URL=postgres://postgres:password@localhost:5432/byos_db?sslmode=disable

# Postgres Password (Docker Compose only)
# Used by the `trmnl_db` container to initialize the DB and by the app's
# DATABASE_URL inside Compose. Must match the password in DATABASE_URL if you
# also set DATABASE_URL manually.
POSTGRES_PASSWORD=password

# React Renderer Configuration
# Options: "takumi" (default) or "satori" or "browser"
# Controls which rendering engine is used for screen generation
REACT_RENDERER=takumi

# Debug Mode
# Set to "true" to enable debug logging
DEBUG=false

# Node Environment
# Options: "development" or "production"
NODE_ENV=development

# Wikipedia API (Optional)
# Access token for Wikipedia API requests
WIKIPEDIA_ACCESS_TOKEN=

# Wikipedia Cache (Optional)
# Set to "true" to force using Reservoir cache for Wikipedia data
FORCE_WIKIPEDIA_RESERVOIR=false

# Authentication
# Set to "false" to disable authentication (mono-user mode)
AUTH_ENABLED=true
BETTER_AUTH_SECRET=your_better_auth_secret_32_characters_min
# Public base URL of the app (used by Better Auth for cookies/redirects).
# Defaults to http://localhost:3777 inside docker-compose if unset.
# Note: the container listens on 3000 internally; docker-compose maps host
# port 3777 -> container 3000 to avoid collisions with other local apps.
BETTER_AUTH_URL=http://localhost:3777
# Admin email - users signing up with this email will automatically become admin
ADMIN_EMAIL=

# TRMNL Live Proxy (Optional)
# By default the read-only TRMNL endpoints (/api/models, /api/palettes,
# /api/categories, /api/ips, /api/markup) are served from a local 24h cache
# seeded by data/trmnl/*.json so the app works offline. Set to "true" to
# bypass the cache and proxy every request to https://usetrmnl.com.
TRMNL_PROXY_LIVE=false

# External Catalog (Optional)
# Set to "true" to allow the server to fetch the community recipe catalog
# (GitHub raw YAML) and the TRMNL official recipes API. When disabled (default),
# the /catalog page shows an empty-state message and recipe installation is
# blocked server-side.
ENABLE_EXTERNAL_CATALOG=false

# Firmware OTA Push (Optional)
# Set to "true" to let the server tell devices to flash the latest official
# TRMNL firmware (from the usetrmnl/trmnl-firmware GitHub release) during their
# /api/display poll. Disabled by default: a BYOS server pushing official
# firmware is the device owner's choice, and the implied S3 binary URLs
# (FW{version}.bin) currently 404 — advertising update_firmware:true with a
# dead URL puts the device in a failed-OTA retry loop where it never renders.
# Even when enabled, the server HEAD-checks the binary and only advertises an
# update if it actually returns 200.
ENABLE_FIRMWARE_OTA=false